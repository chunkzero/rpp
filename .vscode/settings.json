{
  "editor.detectIndentation": false,
  "editor.rulers": [100],
  "rust-analyzer.rustfmt.overrideCommand": ["mise", "exec", "--", "rustfmt", "--emit", "stdout"],
  "stylua.searchBinaryInPATH": true,
  "stylua.disableVersionCheck": true,
  "oxc.enable.oxlint": false,
  "customLocalFormatters.formatters": [
    {
      "command": "mise exec -- google-java-format --aosp -",
      "languages": ["java"]
    },
    {
      "command": "mise exec -- ktlint --log-level=none --format --stdin --stdin-path build.gradle.kts",
      "languages": ["kotlin", "kotlin-script"]
    }
  ],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[java]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.formatOnSave": true
  },
  "[kotlin][kotlin-script]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "[json][jsonc][yaml][toml][markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  }
}
