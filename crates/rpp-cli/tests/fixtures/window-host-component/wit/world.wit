package test:window-host;

world window-host {
    record source-file {
        path: string,
        contents: list<u8>,
    }

    record output-file {
        path: string,
        contents: list<u8>,
    }

    record compile-output {
        files: list<output-file>,
        kotlin-files: list<output-file>,
        warnings: list<string>,
    }

    record optional-values {
        items: list<option<bool>>,
        pair: tuple<option<bool>, option<bool>>,
        nested: list<option<option<bool>>>,
        success: result<option<string>, string>,
        failure: result<string, option<bool>>,
        boolean: result<bool, bool>,
        empty: result,
    }

    export round-trip-options: func(values: optional-values) -> optional-values;

    export compile: func(
        namespace: string,
        project-json: string,
        files: list<source-file>,
        kotlin-package: option<string>,
    ) -> result<compile-output, string>;
}
