package rpp:plugin@0.1.0;

/// Functions the host provides to a guest plugin.
///
/// The generator-phase functions (`list-files`, `read-file`, `read-source`,
/// `emit-file`, `remove-file`) are only meaningful while the guest's
/// `generate` export is running. When the host is *not* in the generate phase
/// it returns empty / no-op results for these calls (see the host crate docs):
/// `list-files` yields an empty list, `read-file`/`read-source` yield `none`,
/// and `emit-file`/`remove-file` are dropped. `log` is always permitted.
interface host {
    /// Severity for host-routed log messages.
    enum log-level {
        debug,
        info,
        warn,
        error,
    }

    /// Emit a log message through the host. Always permitted.
    log: func(level: log-level, message: string);

    /// List output files matching an optional glob pattern.
    /// Returns an empty list outside the generate phase.
    list-files: func(pattern: option<string>) -> list<string>;

    /// Read a processed output file by path. `none` if missing or outside generate.
    read-file: func(path: string) -> option<list<u8>>;

    /// Read a raw source file by path. `none` if missing or outside generate.
    read-source: func(path: string) -> option<list<u8>>;

    /// Add or overwrite an output file. No-op outside the generate phase.
    emit-file: func(path: string, contents: list<u8>);

    /// Remove an output file. No-op outside the generate phase.
    remove-file: func(path: string);
}

/// Functions a guest plugin must export.
interface guest {
    /// A processor declaration: name, the globs it matches, and its priority
    /// (lower runs first).
    record processor-def {
        name: string,
        patterns: list<string>,
        priority: s32,
    }

    /// Static description of a plugin, cached by the host after one
    /// throwaway instantiation.
    record plugin-info {
        id: string,
        version: string,
        processors: list<processor-def>,
        has-generator: bool,
    }

    /// A file flowing through the pipeline. `path` is relative, forward-slash.
    record file-data {
        path: string,
        contents: list<u8>,
    }

    /// Result of running a processor over a file.
    variant process-result {
        /// The file was not changed.
        unchanged,
        /// The file was changed (possibly renamed).
        modified(file-data),
        /// The file should be dropped from the output.
        dropped,
    }

    /// Called once after instantiation. `options-json` is the plugin's
    /// configured options encoded as a JSON string (`{}` if none).
    configure: func(options-json: string);

    /// Return the plugin's static description.
    get-info: func() -> plugin-info;

    /// Run a named processor over a single file.
    process: func(processor: string, file: file-data) -> result<process-result, string>;

    /// Run the generator phase. Host generator functions are live here.
    generate: func() -> result<_, string>;
}

/// The plugin world: imports the host interface, exports the guest interface.
world rpp-plugin {
    import host;
    export guest;
}
