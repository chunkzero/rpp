package rpp:host@0.1.0;

interface process {
    record request {
        program: string,
        args: list<string>,
        cwd: option<string>,
        environment: list<tuple<string, string>>,
        stdin: list<u8>,
        timeout-ms: option<u64>,
    }

    record output {
        status: s32,
        stdout: list<u8>,
        stderr: list<u8>,
    }

    run: func(request: request) -> result<output, string>;
}
